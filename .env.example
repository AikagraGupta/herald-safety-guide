BEEVER_MCP_URL=http://localhost:8000/mcp
BEEVER_MCP_KEY=replace-with-your-mcp-key

# Optional. If omitted, Herald calls whoami -> list_channels and picks a configured channel.
BEEVER_CHANNEL_ID=
BEEVER_CHANNEL_NAME=site-safety

# Beever guide recommends deep mode for reasoning across messages.
BEEVER_ASK_MODE=deep
BEEVER_TIMEOUT_MS=25000
