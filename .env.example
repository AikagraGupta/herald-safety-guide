# Optional. App works anonymously, but a free Pollinations token can improve rate limits.
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=openai
POLLINATIONS_VISION_MODEL=openai

# Optional. If set, Herald uses Aicoo Agent Chat first, then falls back to Pollinations.
AICOO_API_KEY=
AICOO_API_URL=https://www.aicoo.io/api/v1
AICOO_MODEL=
AICOO_TIMEOUT_MS=22000

# Optional. Defaults to OCR.space's demo key, which is rate-limited.
OCR_SPACE_API_KEY=
